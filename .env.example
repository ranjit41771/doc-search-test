# ── Core services ─────────────────────────────────────────────────────────────
ELASTICSEARCH_URL=http://localhost:9200
REDIS_URL=redis://localhost:6379
RABBITMQ_URL=amqp://guest:guest@localhost:5672/
DATABASE_URL=postgresql://root@localhost:26257/defaultdb?sslmode=disable

# ── Elasticsearch index settings ──────────────────────────────────────────────
ES_INDEX=documents
ES_INDEX_SHARDS=5
ES_INDEX_REPLICAS=1

# ── Auth ───────────────────────────────────────────────────────────────────────
# IMPORTANT: Change this to a long random string before deploying to production.
JWT_SECRET=change-me-in-production-use-a-long-random-secret
JWT_ALGORITHM=HS256
JWT_EXPIRY_HOURS=24

# ── Rate limiting ──────────────────────────────────────────────────────────────
RATE_LIMIT_REQUESTS=6000
RATE_LIMIT_WINDOW_SECONDS=60

# ── S3 storage (LocalStack for local development) ─────────────────────────────
# For LocalStack: endpoint URL points to localhost:4566
# For production AWS S3: remove S3_ENDPOINT_URL entirely (or leave blank)
S3_ENDPOINT_URL=http://localhost:4566
S3_BUCKET=document-search
AWS_ACCESS_KEY_ID=test
AWS_SECRET_ACCESS_KEY=test
AWS_REGION=us-east-1

# ── File processing ────────────────────────────────────────────────────────────
MAX_FILE_SIZE_MB=50
CHUNK_SIZE=500
CHUNK_OVERLAP=100
PRESIGNED_URL_EXPIRY=3600
